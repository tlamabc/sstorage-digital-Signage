#: locale/moduletranslate.php:459
msgid "Update Interval (mins)"
msgstr "Khoảng thời gian cập nhật (phút)"

#: locale/moduletranslate.php:48 locale/moduletranslate.php:318
#: locale/moduletranslate.php:326 locale/moduletranslate.php:361
#: locale/moduletranslate.php:460
msgid "Please enter the update interval in minutes. This should be kept as high as possible. For example, if the data will only change once per hour this could be set to 60."
msgstr "Vui lòng nhập khoảng thời gian cập nhật tính bằng phút. Điều này nên được giữ ở mức cao nhất có thể. Ví dụ: nếu dữ liệu chỉ thay đổi một lần mỗi giờ thì dữ liệu này có thể được đặt thành 60."

#: locale/moduletranslate.php:49
msgid "Web Hook triggers"
msgstr "Trình kích hoạt Web Hook"

#: locale/moduletranslate.php:50
msgid "Web Hook triggers can be executed when certain conditions are detected. If you would like to execute a trigger, enter the trigger code below against each event."
msgstr "Trình kích hoạt Web Hook có thể được thực thi khi phát hiện một số điều kiện nhất định. Nếu bạn muốn thực thi trình kích hoạt, hãy nhập mã kích hoạt bên dưới cho mỗi sự kiện."

#: locale/moduletranslate.php:51
msgid "Current Event"
msgstr "Sự kiện hiện tại"

#: locale/moduletranslate.php:52
msgid "Code to be triggered when a event is currently ongoing."
msgstr "Mã được kích hoạt khi một sự kiện hiện đang diễn ra."

#: locale/moduletranslate.php:53
msgid "No Event"
msgstr "Không có sự kiện"

#: locale/moduletranslate.php:54
msgid "Code to be triggered when no events are ongoing at the moment."
msgstr "Mã sẽ được kích hoạt khi không có sự kiện nào đang diễn ra vào lúc này."

