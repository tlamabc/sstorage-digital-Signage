msgstr "Số lượng mục bạn muốn hiển thị."

#: locale/moduletranslate.php:46 locale/moduletranslate.php:585
msgid "When duration is per item then number of items must be 1 or higher"
msgstr "Khi thời lượng cho mỗi mục thì số lượng mục phải từ 1 trở lên"

#: locale/moduletranslate.php:47 locale/moduletranslate.php:317
