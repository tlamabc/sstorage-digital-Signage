msgstr "Nhận sự kiện bằng phạm vi ngày đặt trước?"

#: locale/moduletranslate.php:18
msgid "Use the checkbox to return events within defined start and end dates."
msgstr "Sử dụng hộp kiểm để trả về các sự kiện trong ngày bắt đầu và ngày kết thúc được xác định."

#: locale/moduletranslate.php:19 locale/moduletranslate.php:1082
