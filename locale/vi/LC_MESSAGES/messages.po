#: locale/moduletranslate.php:43 locale/moduletranslate.php:345
#: locale/moduletranslate.php:589
msgid "The duration specified is per item otherwise it is per feed."
msgstr "Thời lượng được chỉ định là cho mỗi mục nếu không thì là cho mỗi nguồn cấp dữ liệu."

#: locale/moduletranslate.php:44
#: cache/58/5827a58c854ad5a45c08da531d11366b.php:206
