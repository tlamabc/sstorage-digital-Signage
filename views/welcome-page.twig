{% extends "authed.twig" %}

{% block title %}{{ "Welcome"|trans }} | {% endblock %}

{% block pageContent %}
    <div id="top" class="welcome-page flex-column" style="background-image: url('{{ theme.rootUri() }}theme/default/img/vector-bg.png');">
        <div class="container-fluid" style="max-width: 1500px;">
            <div class="welcome-header">
                <div class="header-text-content">
                    {% set productName = theme.getThemeConfig('theme_title') %}
                    <h2><strong>CHÀO MỪNG BẠN ĐẾN VỚI CMS SSIGNAGE</strong></h2> 
                    <p>Hệ thống CMS cho phép bạn tạo, quản lý và cập nhật nội dung. Bạn có thể tải lên hình ảnh, video, thiết kế bố cục, lên lịch phát nội dung theo thời gian và vị trí, cũng như kiểm soát toàn bộ mạng lưới hiển thị.</p>
                    <div class="d-flex" style="column-gap: 8px;">
                        <a href="https://drive.sstorage.vn/s/y45GskJGEd5aAcA/download/SSignage%20Player.apk" type="button" class="btn-rounded btn-orange">Download Player APK</a>
                        <a href="https://drive.sstorage.vn/s/jttpWJBBkSbp6kr/download/T%C3%80I%20LI%E1%BB%86U%20HDSD%20SSIGNAGE%20FINAL%20%28v1%29.docx" type="button" class="btn-rounded btn-outlined">Training</a>
                    </div>
                </div>
                <div class="header-image-box">
                    <img class="onboarding-welcome-image" src="{{ theme.rootUri() }}theme/default/img/welcomepage.jpg" alt="Welcome Image">
                </div>
            </div>
            <div class="onboarding-cards-container">
                <img class="line-curve" src="{{ theme.rootUri() }}theme/default/img/line-curve-vector.svg" alt="Welcome Image">
            </div>
            <div class="d-flex flex-column service-card-container" style="row-gap: 40px; margin-top: 80px;">
                {% if currentUser.featureEnabled("displays.view") %}
                    <div class="displays-enabled"></div>
                {% endif %}
                {% if currentUser.featureEnabled("library.view") or currentUser.featureEnabled("layout.view") %}
                    <div class="library-layout-enabled d-flex flex-column" style="row-gap: 40px;"></div>
                {% endif %}
                {% if currentUser.featureEnabled("schedule.view") %}
                    <div class="schedule-enabled"></div>
                {% endif %}
            </div>
            <div class="others-card-container">
            </div>
        </div>
        <a class="scroll-up" href="#top">
            <img style="height:30px; width: 30px;" src="{{ theme.rootUri() }}theme/default/img/onboarding/back-to-top-icon.svg" alt="Welcome Image">
        </a>
    </div>
{% endblock %}

{% block javaScript %}
    {# Initialise JS variables and translations #}
    <script type="text/javascript" nonce="{{ cspNonce }}" defer>
        var isXiboThemed = '{{ theme.getThemeConfig("app_name") }}' === 'Xibo';
        var isSuperAdmin ='{{ currentUser.isSuperAdmin()}}';

        var onboardingCard = [
            {
                title: '{% trans "Displays" %}',
                link: 'displays',
                iconURL: '{{ theme.rootUri() }}theme/default/img/onboarding/displays-icon.png',
            },
            {
                title: 'Nội dung đang có',
                link: 'existing-content',
                iconURL: '{{ theme.rootUri() }}theme/default/img/onboarding/existing-content-icon.png',
            },
            {
                title: '{% trans "Playlists" %}',
                link: 'playlists',
                iconURL: '{{ theme.rootUri() }}theme/default/img/onboarding/playlist-icon.png',
            },
            {
                title: 'Sáng tạo nội dung',
                link: 'create-content',
                iconURL: '{{ theme.rootUri() }}theme/default/img/onboarding/create-content-icon.png',
            },
            {
                title: '{% trans "Schedule" %}',
                link: 'schedule',
                iconURL: '{{ theme.rootUri() }}theme/default/img/onboarding/schedule-icon.png',
            },
        ];

        var serviceCards = [
            {
                title: 'Màn hình',
                text: 'Bắt đầu bằng cách cài đặt một trong các Trình phát của chúng tôi và nhập mã ghép nối vào <a class="text-link">trang Hiển thị</a> để bạn có thể hiển thị nội dung của mình. Nếu bạn không có thiết bị để sử dụng làm Người chơi, bạn có thể xem trước và kiểm tra lịch trình trong trình duyệt web của mình.',
                firstLink: '{{ url_for("display.view")}}',
                secondLink: '{{ helpService.getLandingPage}}displays.html',
                imageUrl: '{{ theme.rootUri() }}theme/default/img/onboarding/displays.png',
                serviceId: 'displays',
                featureFlag: "displays.view"
            },
            {
                title: 'Nội dung đang có',
                text: 'Bạn đã có sẵn nội dung để hiển thị chưa? Bắt đầu hiển thị điều đó trong 2 bước đơn giản. Tải mọi hình ảnh hoặc video toàn màn hình hiện có lên <a class="text-link">Thư viện phương tiện</a>, sau đó lên lịch hiển thị những hình ảnh hoặc video đó khi bạn muốn trên màn hình của mình từ <a class="text-link">Schedule page</a>.',
                firstLink: '{{ url_for("library.view")}}',
                secondLink: '{{ url_for("schedule.view")}}',
                otherLink: '{{ helpService.getLandingPage }}media_library.html',
                imageUrl: '{{ theme.rootUri() }}theme/default/img/onboarding/existing-content.png',
                serviceId: 'existing-content',
                featureFlag: ["library.view", "layout.view"],
                showLink: true
            },
            {
                title: 'Danh sách phát',
                text: 'Nếu bạn có nhiều hình ảnh hoặc video để hiển thị, hãy đưa chúng vào Danh sách phát rồi lên lịch cho Danh sách phát trên màn hình của bạn để quản lý dễ dàng hơn.',
                firstLink: '{{ url_for("playlist.view") }}',
                secondLink: '{{ helpService.getLandingPage }}media_playlists.html',    
                imageUrl: '{{ theme.rootUri() }}theme/default/img/onboarding/playlists.png',
                serviceId: 'playlists',
                featureFlag: ["library.view", "layout.view"]
            },
            {
                title: 'Tạo nội dung',
                text: 'Nếu bạn cần tạo nội dung phức tạp hơn, Trình chỉnh sửa bố cục luôn sẵn sàng giúp bạn tạo nội dung ấn tượng. Có những mẫu được thiết kế sẵn mà bạn có thể làm việc hoặc bạn có thể tạo thứ gì đó từ đầu.',
                firstLink: '{{ url_for("layout.view") }}',
                secondLink: '{{ helpService.getLandingPage }}layouts_editor.html',
                imageUrl: '{{ theme.rootUri() }}theme/default/img/onboarding/create-content.png',
                serviceId: 'create-content',
                featureFlag: ["library.view", "layout.view"]
            },
            {
                title: 'Lên lịch',
                text: 'Bạn có thể kết hợp giữa việc lên lịch các mục phương tiện, bố cục và chiến dịch theo ý muốn. Nếu bạn lên lịch nhiều việc cùng lúc, chúng sẽ lần lượt được hiển thị.',
                firstLink: '{{ url_for("schedule.view") }}',
                secondLink: '{{ helpService.getLandingPage }}scheduling_events.html',
                imageUrl: '{{ theme.rootUri() }}theme/default/img/onboarding/schedule.png',
                serviceId: 'schedule',
                featureFlag: "schedule.view"
            }
        ];

        var othersCards = [
            {
            title: 'Về chúng tôi',
            text: 'Phần mềm cài đặt trên máy chủ quản lý tập trung và Giao diện quản lý sử dụng công nghệ điện toán đám mây của SStorage chúng tôi.',
            links: `
                <a href="https://sstorage.vn/dv-ssignage-digital/" target="_blank">sstorage.vn</a>
                ${isXiboThemed && isSuperAdmin ? 
                `<a href="https://sstorage.vn/lien-he/" target="_blank">{% trans "Admin" %}</a>
                 <a href="https://sstorage.vn/lien-he/" target="_blank">{% trans "Developer" %}</a>` : ''
                }`,
            imageUrl: "{{ theme.rootUri() }}theme/default/img/xibologo.png",
            },
        ];

        if (isXiboThemed) {
            othersCards.push({
                title: 'Liên Hệ Để Hỗ Trợ',
                text: `Địa chỉ: Tầng 5, 27A Hoàng Việt, F4, Quận Tân Bình, TP Hồ Chí Minh
            Hotline: 0906 618 181
            E-mail: sstorage@icsp.vn`.replace(/\n/g, "<br>"),
                links: isXiboThemed ? `
                    <a href="https://sstorage.vn/lien-he/" target="_blank">{% trans "Trung tâm hỗ trợ" %}</a>
                    <a href="https://sstorage.vn/lien-he/" target="_blank">{% trans "Cộng đồng" %}</a>
                ` : '',
                iconName: "help"
            });

        }

        othersCards.push({
            title: 'Liên Hệ Để Hỗ Trợ',
            text: `Hotline: 0906 618 181`,
            links: isXiboThemed ? `
                <a href="https://sstorage.vn/lien-he/" target="_blank">{% trans "Trung tâm hỗ trợ" %}</a>
                <a href="https://sstorage.vn/lien-he/" target="_blank">{% trans "Cộng đồng" %}</a>
            ` : '',
            iconName: "help"
        });



    </script>

    {# Add page source code bundle ( JS and CSS ) #}
    <script src="{{ theme.rootUri() }}dist/pages/welcome-page.bundle.min.js?v={{ version }}&rev={{revision}}" nonce="{{ cspNonce }}"></script>
{% endblock %}