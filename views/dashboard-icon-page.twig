{% extends "authed.twig" %}
{% import "inline.twig" as inline %}

{% block pageContent %}
    {% include "theme-dashboard-message.twig" ignore missing %}
    <div class="modern-dashboard">
        <div class="dashboard-header">
            <h1 class="dashboard-title">Chào mừng đến với SStorage CMS</h1>
            <p class="dashboard-subtitle">Quản lý nội dung số của bạn một cách hiệu quả</p>
        </div>
        <div class="dashboard-tiles">
            {% if currentUser.featureEnabled("schedule.view") %}
                <div class="tile tile-schedule animate-tile" data-tooltip="Lên lịch phát nội dung">
                    <a href="{{ url_for("schedule.view") }}">
                        <div class="tile-icon-wrapper">
                            <img src="{{ theme.uri("img/dashboard/scheduleview.png") }}" class="tile-icon" alt="Lập lịch" />
                        </div>
                        <span class="tile-title">Lập lịch</span>
                    </a>
                </div>
            {% endif %}

            {% if currentUser.featureEnabled("layout.view") %}
                <div class="tile tile-layout animate-tile" data-tooltip="Thiết kế bố cục hiển thị">
                    <a href="{{ url_for("layout.view") }}">
                        <div class="tile-icon-wrapper">
                            <img src="{{ theme.uri("img/dashboard/presentations.png") }}" class="tile-icon" alt="Bố cục" />
                        </div>
                        <span class="tile-title">Bố cục</span>
                    </a>
                </div>
            {% endif %}

            {% if currentUser.featureEnabled("library.view") %}
                <div class="tile tile-library animate-tile" data-tooltip="Quản lý thư viện media">
                    <a href="{{ url_for("library.view") }}">
                        <div class="tile-icon-wrapper">
                            <img src="{{ theme.uri("img/dashboard/content.png") }}" class="tile-icon" alt="Thư viện" />
                        </div>
                        <span class="tile-title">Thư viện</span>
                    </a>
                </div>
            {% endif %}

            {% if currentUser.featureEnabled("template.view") %}
                <div class="tile tile-template animate-tile" data-tooltip="Tạo mẫu nội dung nhanh">
                    <a href="{{ url_for("template.view") }}">
                        <div class="tile-icon-wrapper">
                            <img src="{{ theme.uri("img/dashboard/layouts.png") }}" class="tile-icon" alt="Mẫu" />
                        </div>
                        <span class="tile-title">Mẫu</span>
                    </a>
                </div>
            {% endif %}

            {% if currentUser.featureEnabled("users.view") and (currentUser.isGroupAdmin() or currentUser.isSuperAdmin()) %}
                <div class="tile tile-users animate-tile" data-tooltip="Quản lý tài khoản người dùng">
                    <a href="{{ url_for("user.view") }}">
                        <div class="tile-icon-wrapper">
                            <img src="{{ theme.uri("img/dashboard/users.png") }}" class="tile-icon" alt="Người dùng" />
                        </div>
                        <span class="tile-title">Người dùng</span>
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block styles %}
    <style>
        /* Reset mặc định */
        #dashbuttons {
            margin: 0;
            padding: 0;
        }

        /* Dashboard Container */
        .modern-dashboard {
            min-height: 100vh;
            background: linear-gradient(135deg, #e0eafc 0%, #cfdef3 100%); /* Gradient nền nhẹ nhàng */
            padding: 60px 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Header */
        .dashboard-header {
            text-align: center;
            margin-bottom: 60px;
            color: #2c3e50;
        }

        .dashboard-title {
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 48px;
            font-weight: 700;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.1);
            animation: fadeIn 1s ease-in-out;
        }

        .dashboard-subtitle {
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 20px;
            color: #7f8c8d;
            margin-top: 10px;
            animation: fadeIn 1.5s ease-in-out;
        }

        /* Tiles Container */
        .dashboard-tiles {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); /* Tự động điều chỉnh, tối thiểu 300px */
            gap: 40px;
            max-width: 1400px;
            width: 100%;
        }

        /* Tile Styles */
        .tile {
            position: relative;
            width: 100%;
            height: 300px;
            background: rgba(255, 255, 255, 0.2); /* Hiệu ứng kính mờ */
            border-radius: 20px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            overflow: hidden;
            cursor: pointer;
        }

        .tile a {
            text-decoration: none;
            color: #2c3e50;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        /* Gradient Background for Tiles */
        .tile-schedule { background: linear-gradient(45deg, #3498db, #8e44ad); }
        .tile-layout { background: linear-gradient(45deg, #9b59b6, #e74c3c); }
        .tile-library { background: linear-gradient(45deg, #f1c40f, #e67e22); }
        .tile-template { background: linear-gradient(45deg, #27ae60, #2ecc71); }
        .tile-users { background: linear-gradient(45deg, #e91e63, #9c27b0); }

        /* Tile Icon */
        .tile-icon-wrapper {
            width: 120px;
            height: 120px;
            display: flex;
            justify-content: center;
            align-items: center;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            margin-bottom: 20px;
            transition: transform 0.3s ease;
        }

        .tile-icon {
            width: 80px;
            height: 80px;
            filter: brightness(0) invert(1); /* Chuyển icon thành màu trắng */
        }

        .tile:hover .tile-icon-wrapper {
            transform: scale(1.1);
        }

        /* Tile Title */
        .tile-title {
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 24px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #fff;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.2);
        }

        /* Hover Effect */
        .tile:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        }

        /* Tooltip */
        .tile::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: -40px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 10px 20px;
            border-radius: 5px;
            font-size: 14px;
            white-space: nowrap;
            opacity: 0;
            transition: opacity 0.3s ease, bottom 0.3s ease;
            pointer-events: none;
        }

        .tile:hover::after {
            opacity: 1;
            bottom: -30px;
        }

        /* Animation */
        .animate-tile {
            animation: fadeInUp 0.8s ease-in-out forwards;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px) scale(0.9);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        /* Ẩn CSS cũ */
        .dashicons, .dash_button, .dash_text {
            display: none;
        }
    </style>
{% endblock %}