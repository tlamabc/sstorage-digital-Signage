{% extends "authed.twig" %}
{% import "inline.twig" as inline %}

{% block pageContent %}
    {% include "theme-dashboard-message.twig" ignore missing %}
    <div id="dashbuttons" class="metro-dashboard">
        {% if currentUser.featureEnabled("schedule.view") %}
            <div class="tile tile-square tile-cyan scale-up">
                <a href="{{ url_for("schedule.view") }}">
                    <img src="{{ theme.uri("img/dashboard/scheduleview.png") }}" class="tile-icon" alt="Schedule Icon" />
                    <span class="tile-text">{% trans "Schedule" %}</span>
                </a>
            </div>
        {% endif %}

        {% if currentUser.featureEnabled("layout.view") %}
            <div class="tile tile-square tile-purple scale-up">
                <a href="{{ url_for("layout.view") }}">
                    <img src="{{ theme.uri("img/dashboard/presentations.png") }}" class="tile-icon" alt="Layouts Icon" />
                    <span class="tile-text">{% trans "Layouts" %}</span>
                </a>
            </div>
        {% endif %}

        {% if currentUser.featureEnabled("library.view") %}
            <div class="tile tile-square tile-orange scale-up">
                <a href="{{ url_for("library.view") }}">
                    <img src="{{ theme.uri("img/dashboard/content.png") }}" class="tile-icon" alt="Library Icon" />
                    <span class="tile-text">{% trans "Library" %}</span>
                </a>
            </div>
        {% endif %}

        {% if currentUser.featureEnabled("template.view") %}
            <div class="tile tile-square tile-green scale-up">
                <a href="{{ url_for("template.view") }}">
                    <img src="{{ theme.uri("img/dashboard/layouts.png") }}" class="tile-icon" alt="Templates Icon" />
                    <span class="tile-text">{% trans "Templates" %}</span>
                </a>
            </div>
        {% endif %}

        {% if currentUser.featureEnabled("users.view") and (currentUser.isGroupAdmin() or currentUser.isSuperAdmin()) %}
            <div class="tile tile-square tile-magenta scale-up">
                <a href="{{ url_for("user.view") }}">
                    <img src="{{ theme.uri("img/dashboard/users.png") }}" class="tile-icon" alt="Users Icon" />
                    <span class="tile-text">{% trans "Users" %}</span>
                </a>
            </div>
        {% endif %}

        {% if currentUser.isSuperUser() %}
            <div class="tile tile-square tile-blue scale-up">
                <a href="{{ url_for("admin.view") }}">
                    <img src="{{ theme.uri("img/dashboard/settings.png") }}" class="tile-icon" alt="Settings Icon" />
                    <span class="tile-text">{% trans "Settings" %}</span>
                </a>
            </div>
        {% endif %}

        <div class="tile tile-square tile-grey scale-up">
            <a href="{{ url_for("license.view") }}">
                <img src="{{ theme.uri("img/dashboard/license.png") }}" class="tile-icon" alt="About Icon" />
                <span class="tile-text">{% trans "About" %}</span>
            </a>
        </div>

        {% if currentUser.featureEnabled("troubleshooting.fault") %}
            <div class="tile tile-square tile-red scale-up">
                <a href="{{ url_for("fault.view") }}">
                    <img src="{{ theme.uri("img/dashboard/help.png") }}" class="tile-icon" alt="Report Fault Icon" />
                    <span class="tile-text">{% trans "Report Fault" %}</span>
                </a>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block styles %}
    <style>
        /* Reset mặc định để đảm bảo không bị ảnh hưởng bởi CSS gốc */
        #dashbuttons {
            margin: 0;
            padding: 0;
        }

        /* Metro Dashboard Styles - Desktop */
        .metro-dashboard {
            display: grid;
            grid-template-columns: repeat(4, 1fr); /* 4 cột cho desktop */
            gap: 20px;
            padding: 40px;
            max-width: 1200px;
            margin: 0 auto;
            background-color: #f5f5f5; /* Nền nhẹ để nổi bật các ô */
        }

        .tile {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            border-radius: 10px;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .tile a {
            text-decoration: none;
            color: white;
            width: 100%;
            height: 100%;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .tile:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

        /* Tile Size - Vuông đồng nhất */
        .tile-square {
            width: 250px; /* Kích thước lớn hơn cho desktop */
            height: 250px;
        }

        /* Tile Colors - Mỗi ô một màu */
        .tile-cyan { background-color: #1BA1E2; } /* Schedule */
        .tile-purple { background-color: #AA00FF; } /* Layouts */
        .tile-orange { background-color: #F09609; } /* Library */
        .tile-green { background-color: #00CC00; } /* Templates */
        .tile-magenta { background-color: #D80073; } /* Users */
        .tile-blue { background-color: #0050EF; } /* Settings */
        .tile-grey { background-color: #6A6A6A; } /* About */
        .tile-red { background-color: #E51400; } /* Report Fault */

        /* Tile Content */
        .tile-icon {
            width: 100px; /* Icon lớn hơn cho desktop */
            height: 100px;
            margin-bottom: 15px;
        }

        .tile-text {
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 20px; /* Chữ lớn hơn cho desktop */
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Animation */
        .scale-up {
            animation: scaleUp 0.8s ease-in-out forwards;
        }

        @keyframes scaleUp {
            from {
                transform: scale(0.7);
                opacity: 0;
            }
            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        /* Đảm bảo không bị ảnh hưởng bởi CSS mặc định của theme */
        .dashicons, .dash_button, .dash_text {
            display: none; /* Ẩn các class cũ nếu có xung đột */
        }
    </style>
{% endblock %}