{% extends "authed.twig" %}
{% import "inline.twig" as inline %}

{% block pageContent %}
    {% include "theme-dashboard-message.twig" ignore missing %}
    <div class="modern-dashboard">
        <div class="dashboard-header">
            <h1 class="dashboard-title">Chào mừng đến với SStorage CMS</h1>
            <p class="dashboard-subtitle">Quản lý nội dung số của bạn một cách dễ dàng và hiệu quả</p>
        </div>
        <div class="dashboard-tiles">
            {% if currentUser.featureEnabled("schedule.view") %}
                <div class="tile tile-schedule animate-tile" data-tooltip="Lên lịch phát nội dung">
                    <a href="{{ url_for("schedule.view") }}">
                        <div class="tile-icon-wrapper">
                            <img src="{{ theme.uri("img/dashboard/scheduleview.png") }}" class="tile-icon" alt="Lập lịch" />
                        </div>
                        <span class="tile-title">Lập lịch</span>
                    </a>
                </div>
            {% endif %}

            {% if currentUser.featureEnabled("layout.view") %}
                <div class="tile tile-layout animate-tile" data-tooltip="Thiết kế bố cục hiển thị">
                    <a href="{{ url_for("layout.view") }}">
                        <div class="tile-icon-wrapper">
                            <img src="{{ theme.uri("img/dashboard/presentations.png") }}" class="tile-icon" alt="Bố cục" />
                        </div>
                        <span class="tile-title">Bố cục</span>
                    </a>
                </div>
            {% endif %}

            {% if currentUser.featureEnabled("library.view") %}
                <div class="tile tile-library animate-tile" data-tooltip="Quản lý thư viện media">
                    <a href="{{ url_for("library.view") }}">
                        <div class="tile-icon-wrapper">
                            <img src="{{ theme.uri("img/dashboard/content.png") }}" class="tile-icon" alt="Thư viện" />
                        </div>
                        <span class="tile-title">Thư viện</span>
                    </a>
                </div>
            {% endif %}

            {% if currentUser.featureEnabled("template.view") %}
                <div class="tile tile-template animate-tile" data-tooltip="Tạo mẫu nội dung nhanh">
                    <a href="{{ url_for("template.view") }}">
                        <div class="tile-icon-wrapper">
                            <img src="{{ theme.uri("img/dashboard/layouts.png") }}" class="tile-icon" alt="Mẫu" />
                        </div>
                        <span class="tile-title">Mẫu</span>
                    </a>
                </div>
            {% endif %}

            {% if currentUser.featureEnabled("users.view") and (currentUser.isGroupAdmin() or currentUser.isSuperAdmin()) %}
                <div class="tile tile-users animate-tile" data-tooltip="Quản lý tài khoản người dùng">
                    <a href="{{ url_for("user.view") }}">
                        <div class="tile-icon-wrapper">
                            <img src="{{ theme.uri("img/dashboard/users.png") }}" class="tile-icon" alt="Người dùng" />
                        </div>
                        <span class="tile-title">Người dùng</span>
                    </a>
                </div>
            {% endif %}

            <div class="tile tile-about animate-tile" data-tooltip="Thông tin về hệ thống">
                <a href="{{ url_for("license.view") }}">
                    <div class="tile-icon-wrapper">
                        <img src="{{ theme.uri("img/dashboard/license.png") }}" class="tile-icon" alt="Về" />
                    </div>
                    <span class="tile-title">Về</span>
                </a>
            </div>

            {% if currentUser.featureEnabled("troubleshooting.fault") %}
                <div class="tile tile-report animate-tile" data-tooltip="Báo cáo sự cố hệ thống">
                    <a href="{{ url_for("fault.view") }}">
                        <div class="tile-icon-wrapper">
                            <img src="{{ theme.uri("img/dashboard/help.png") }}" class="tile-icon" alt="Báo lỗi" />
                        </div>
                        <span class="tile-title">Báo lỗi</span>
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block styles %}
    <style>
        /* Reset mặc định */
        #dashbuttons {
            margin: 0;
            padding: 0;
        }

        /* Dashboard Container */
        .modern-dashboard {
            min-height: 100vh;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            padding: 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Header */
        .dashboard-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .dashboard-title {
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 48px;
            font-weight: 700;
            color: #ffffff;
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.3);
            animation: fadeIn 1s ease-in-out;
        }

        .dashboard-subtitle {
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 20px;
            color: #d1d8e0;
            margin-top: 10px;
            animation: fadeIn 1.5s ease-in-out;
        }

        /* Tiles Container */
        .dashboard-tiles {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            max-width: 1200px;
            width: 100%;
        }

        /* Tile Styles */
        .tile {
            position: relative;
            width: 250px;
            height: 250px;
            background: rgba(255, 255, 255, 0.1); /* Glassmorphism effect */
            border-radius: 15px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            overflow: hidden;
        }

        .tile a {
            text-decoration: none;
            color: white;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        /* Gradient Background for Tiles */
        .tile-schedule { background: linear-gradient(45deg, #1BA1E2, #2ECC71); }
        .tile-layout { background: linear-gradient(45deg, #AA00FF, #E91E63); }
        .tile-library { background: linear-gradient(45deg, #F09609, #FF5722); }
        .tile-template { background: linear-gradient(45deg, #00CC00, #4CAF50); }
        .tile-users { background: linear-gradient(45deg, #D80073, #FF4081); }
        .tile-about { background: linear-gradient(45deg, #6A6A6A, #B0BEC5); }
        .tile-report { background: linear-gradient(45deg, #E51400, #FF9800); }

        /* Tile Icon */
        .tile-icon-wrapper {
            width: 100px;
            height: 100px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 15px;
        }

        .tile-icon {
            width: 80px;
            height: 80px;
            transition: transform 0.3s ease;
        }

        .tile:hover .tile-icon {
            transform: rotate(10deg) scale(1.1);
        }

        /* Tile Title */
        .tile-title {
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 22px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Hover Effect */
        .tile:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
        }

        /* Tooltip */
        .tile::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: -40px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.8);
            color: white;
            padding: 8px 15px;
            border-radius: 5px;
            font-size: 14px;
            white-space: nowrap;
            opacity: 0;
            transition: opacity 0.3s ease, bottom 0.3s ease;
            pointer-events: none;
        }

        .tile:hover::after {
            opacity: 1;
            bottom: -30px;
        }

        /* Animation */
        .animate-tile {
            animation: fadeInUp 0.8s ease-in-out forwards;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px) scale(0.9);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        /* Ẩn CSS cũ */
        .dashicons, .dash_button, .dash_text {
            display: none;
        }
    </style>
{% endblock %}