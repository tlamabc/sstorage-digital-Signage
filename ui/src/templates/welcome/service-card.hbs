<div id="{{serviceId}}" class="service-card">
    <img class="service-card-image" src="{{imageUrl}}" alt="{{serviceId}}">
    <div class="service-card-text">
        <h3>{{title}}</h3>
        <p>{{{text}}}</p>
        <div class="d-flex align-items-center" style="column-gap: 8px; margin-top: auto;">
            {{#if showLink}}
            <a href="{{firstLink}}" class="btn-rounded btn-orange">Tải lên nội dung</a>
            <a href="{{secondLink}}" class="btn-rounded btn-outlined" target="_blank">Lên lịch</a>
            {{else}}
            <a href="{{firstLink}}" class="btn-rounded btn-orange">Bắt đầu</a>
            {{/if}}
        </div>
    </div>
</div>